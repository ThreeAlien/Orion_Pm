// Orion PM 資料模型
// 對應 Notion Orion 三 db（任務 / 專案 / 文件）+ 加任務階層 + 依賴鏈
// docs: prisma/README.md（之後寫）

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum TaskStatus {
  TODO
  DISCUSSING
  ON_HOLD
  IN_PROGRESS
  WAITING_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNING
  PAUSED
  IN_PROGRESS
  DONE
}

enum DocType {
  MEETING
  RESEARCH
  DEV_NOTE
  PRODUCT
  TEST
  TEAM_GUIDE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ==================== Core ====================

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  avatarUrl     String?
  image         String?
  /// 自訂頭貼底色（color token，沒上傳照片時用；null = 依名字自動配色）
  avatarColor   String?
  // Auth.js v5 fields
  emailVerified DateTime?

  ownedProjects Project[]       @relation("ProjectOwner")
  memberOf      ProjectMember[]
  assignedTasks Task[]          @relation("Assignee")
  taskAssignees TaskAssignee[]
  authoredDocs  Document[]      @relation("DocAuthor")
  comments      Comment[]
  activities    Activity[]

  // Google Calendar 串接（token 落地 + 我方建立的事件對應）
  googleToken    GoogleToken?
  calendarEvents CalendarEvent[] @relation("UserCalendarEvents")

  // 收到的通知（目前只有「被 @」）
  notifications  Notification[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
}

// 使用者的 Google OAuth token（JWT 策略下沒有 Account 表，自存一張）。
// access token 會過期 → 用 refresh token 換新；refresh token 在 Testing 模式 7 天到期需重新授權。
model GoogleToken {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  /// access token 到期的 unix 秒數
  expiresAt    Int?
  scope        String?
  updatedAt    DateTime @updatedAt
}

// 行事曆「事件」（跟任務分開）。我方建立的會 push 到 Google 並存 googleEventId 以便日後 update/delete。
model CalendarEvent {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation("UserCalendarEvents", fields: [userId], references: [id], onDelete: Cascade)
  /// 對應的 Google 事件 id（我方建立 push 成功後寫入）；null = 尚未同步 / 純本地
  googleEventId    String?
  /// 通常是 "primary"（使用者主行事曆）
  googleCalendarId String   @default("primary")
  title            String
  description      String?
  location         String?
  start            DateTime
  end              DateTime
  allDay           Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId, start])
  @@index([googleEventId])
}

model Project {
  id          String            @id @default(cuid())
  name        String
  description String?
  /// 顯示用色票 — red / green / orange / purple / blue / pink / teal
  color       String            @default("blue")
  status      ProjectStatus     @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  fileUrl     String?

  // 客戶資訊（業主填）
  customerName String?
  taxId        String?
  brandName    String?

  // 檔案統籌表：[{ label, url }] 連結清單，業主自填、快速點開檔案位置
  fileLinks    Json   @default("[]")

  ownerId     String
  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id])

  // 團隊歸屬（工程 / 行銷）。nullable：未分類的專案出現在「全部」，由業主在專案設定指派
  teamId      String?
  team        Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)

  members     ProjectMember[]
  tasks       Task[]
  documents   ProjectDocument[]

  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, startDate])
  @@index([ownerId])
  @@index([teamId])
}

// 團隊（工程 / 行銷…）。專案歸屬單一團隊；跨團隊協作走任務卡片聯繫（TaskLink），不設共用區
model Team {
  id        String    @id @default(cuid())
  name      String
  /// 穩定識別碼（engineering / marketing），給 filter / cookie 用，不隨改名變動
  slug      String    @unique
  /// 顯示色票 token（同 Project.color 規則）
  color     String    @default("blue")
  sort      Int       @default(0)

  projects  Project[]
  // 直屬此團隊的任務（沒掛專案、但指定了團隊的卡）
  tasks     Task[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProjectMember {
  projectId String
  userId    String
  role      MemberRole @default(MEMBER)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime   @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id           String           @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus       @default(TODO)
  priority     TaskPriority     @default(MEDIUM)
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  archived     Boolean          @default(false)

  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // 直屬團隊：給「沒掛專案」的卡片用，讓它在多團隊看板仍能歸隊。
  // 顯示時專案的團隊優先（有專案跟專案走），沒專案才用這個 fallback。
  teamId       String?
  team         Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)

  // 主負責人（denormalized，給外部 API / 活動軌跡用）；完整清單看 assignees
  assigneeId   String?
  assignee     User?            @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // 多負責人（真正的負責人清單，一個任務可掛多人）
  assignees    TaskAssignee[]

  // 任務階層（Parent ↔ Sub-task，self-relation）
  parentTaskId String?
  parentTask   Task?            @relation("Subtask", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]           @relation("Subtask")

  documents    TaskDocument[]
  comments     Comment[]
  activities   Activity[]
  checklist    ChecklistItem[]
  notifications Notification[]

  // 卡片聯繫（跨團隊交流用，純參考 / peek，無 blocking 語意）
  links        TaskLink[]       @relation("TaskLinkFrom")
  linkedBy     TaskLink[]       @relation("TaskLinkTo")

  /// 看板手動排序（同 status 內順序），float 便於插入時不重排
  position     Float            @default(0)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId, status])
  @@index([assigneeId, dueDate])
  @@index([parentTaskId])
  @@index([status, position])
  @@index([teamId])
}

// 任務 ↔ 負責人 多對多（一個任務可掛多位負責人）
model TaskAssignee {
  taskId String
  userId String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

// 卡片聯繫：task ↔ task 中性關聯（顯示時雙向 union）。跨團隊交流，無 blocking / 排序語意。
model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  linkedId  String

  task      Task     @relation("TaskLinkFrom", fields: [taskId], references: [id], onDelete: Cascade)
  linked    Task     @relation("TaskLinkTo", fields: [linkedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, linkedId])
  @@index([linkedId])
}

// ==================== Collaboration（留言 + 活動軌跡）====================

model Comment {
  id        String   @id @default(cuid())
  body      String

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // 作者離開系統 → 留言保留，顯示「已移除使用者」
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

/// 自動記錄的欄位變更軌跡。fromValue / toValue 寫入當下的人類可讀字串（label / 名字 / 日期）
model Activity {
  id        String       @id @default(cuid())
  field     ActivityField
  fromValue String?
  toValue   String?

  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
}

enum ActivityField {
  CREATED
  STATUS
  ASSIGNEE
  PRIORITY
  START_DATE
  DUE_DATE
}

/// 任務內的輕量工作清單項（純文字 + 勾選），position 用 float 便於拖排插入不重排
model ChecklistItem {
  id        String   @id @default(cuid())
  content   String
  done      Boolean  @default(false)
  position  Float    @default(0)

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, position])
}

// ==================== Documents ====================

model Document {
  id          String            @id @default(cuid())
  name        String
  docType     DocType
  date        DateTime?
  contentUrl  String?
  /// rich text body（之後可改 jsonb 接 Tiptap / Lexical）
  body        String?

  authorId    String?
  author      User?             @relation("DocAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  tasks       TaskDocument[]
  projects    ProjectDocument[]

  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([docType, date])
  @@index([authorId])
}

model TaskDocument {
  taskId     String
  documentId String

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([taskId, documentId])
  @@index([documentId])
}

model ProjectDocument {
  projectId  String
  documentId String

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([projectId, documentId])
  @@index([documentId])
}

// 富文本貼圖：留言 / 描述貼上或選取的圖片，前端壓成 webp 後存這裡（DB-backed，
// 無物件儲存、可撐過容器重建）。HTML 內只放 <img src="/api/images/{id}">，不塞 base64。
model Image {
  id         String   @id @default(cuid())
  mime       String   @default("image/webp")
  bytes      Bytes
  /// 上傳者（純記錄，不建 FK；使用者刪除也保留圖片）
  uploaderId String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// 通知（目前只有「被 @ 提及」）。被 @ 的人收到一筆，未讀會在鈴鐺顯示數字、
// 對應卡片在看板標色；點進卡片 / 看通知就標已讀。
model Notification {
  id          String   @id @default(cuid())

  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  type        String   @default("MENTION")
  /// 觸發者名字（denormalized，留言當下的名字；觸發者改名不影響舊通知）
  actorName   String?
  /// 來源任務（點通知 / 卡片標色用）
  taskId      String?
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 來源留言（可選，描述提及為 null）
  commentId   String?

  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([recipientId, read])
  @@index([recipientId, createdAt])
}
