// Orion PM 資料模型
// 對應 Notion Orion 三 db（任務 / 專案 / 文件）+ 加任務階層 + 依賴鏈
// docs: prisma/README.md（之後寫）

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================== Enums ====================

enum TaskStatus {
  TODO
  DISCUSSING
  ON_HOLD
  IN_PROGRESS
  WAITING_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  PLANNING
  PAUSED
  IN_PROGRESS
  DONE
}

enum DocType {
  MEETING
  RESEARCH
  DEV_NOTE
  PRODUCT
  TEST
  TEAM_GUIDE
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ==================== Core ====================

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String
  avatarUrl     String?
  image         String?
  // Auth.js v5 fields
  emailVerified DateTime?

  ownedProjects Project[]       @relation("ProjectOwner")
  memberOf      ProjectMember[]
  assignedTasks Task[]          @relation("Assignee")
  authoredDocs  Document[]      @relation("DocAuthor")
  comments      Comment[]
  activities    Activity[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
}

model Project {
  id          String            @id @default(cuid())
  name        String
  description String?
  /// 顯示用色票 — red / green / orange / purple / blue / pink / teal
  color       String            @default("blue")
  status      ProjectStatus     @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  fileUrl     String?

  ownerId     String
  owner       User              @relation("ProjectOwner", fields: [ownerId], references: [id])

  // 團隊歸屬（工程 / 行銷）。nullable：未分類的專案出現在「全部」，由業主在專案設定指派
  teamId      String?
  team        Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)

  members     ProjectMember[]
  tasks       Task[]
  documents   ProjectDocument[]

  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([status, startDate])
  @@index([ownerId])
  @@index([teamId])
}

// 團隊（工程 / 行銷…）。專案歸屬單一團隊；跨團隊協作走任務卡片聯繫（TaskLink），不設共用區
model Team {
  id        String    @id @default(cuid())
  name      String
  /// 穩定識別碼（engineering / marketing），給 filter / cookie 用，不隨改名變動
  slug      String    @unique
  /// 顯示色票 token（同 Project.color 規則）
  color     String    @default("blue")
  sort      Int       @default(0)

  projects  Project[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ProjectMember {
  projectId String
  userId    String
  role      MemberRole @default(MEMBER)

  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt  DateTime   @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Task {
  id           String           @id @default(cuid())
  title        String
  description  String?
  status       TaskStatus       @default(TODO)
  priority     TaskPriority     @default(MEDIUM)
  startDate    DateTime?
  dueDate      DateTime?
  completedAt  DateTime?
  archived     Boolean          @default(false)

  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)

  assigneeId   String?
  assignee     User?            @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  // 任務階層（Parent ↔ Sub-task，self-relation）
  parentTaskId String?
  parentTask   Task?            @relation("Subtask", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks     Task[]           @relation("Subtask")

  documents    TaskDocument[]
  comments     Comment[]
  activities   Activity[]
  checklist    ChecklistItem[]

  // 卡片聯繫（跨團隊交流用，純參考 / peek，無 blocking 語意）
  links        TaskLink[]       @relation("TaskLinkFrom")
  linkedBy     TaskLink[]       @relation("TaskLinkTo")

  /// 看板手動排序（同 status 內順序），float 便於插入時不重排
  position     Float            @default(0)

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([projectId, status])
  @@index([assigneeId, dueDate])
  @@index([parentTaskId])
  @@index([status, position])
}

// 卡片聯繫：task ↔ task 中性關聯（顯示時雙向 union）。跨團隊交流，無 blocking / 排序語意。
model TaskLink {
  id        String   @id @default(cuid())
  taskId    String
  linkedId  String

  task      Task     @relation("TaskLinkFrom", fields: [taskId], references: [id], onDelete: Cascade)
  linked    Task     @relation("TaskLinkTo", fields: [linkedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([taskId, linkedId])
  @@index([linkedId])
}

// ==================== Collaboration（留言 + 活動軌跡）====================

model Comment {
  id        String   @id @default(cuid())
  body      String

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  // 作者離開系統 → 留言保留，顯示「已移除使用者」
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

/// 自動記錄的欄位變更軌跡。fromValue / toValue 寫入當下的人類可讀字串（label / 名字 / 日期）
model Activity {
  id        String       @id @default(cuid())
  field     ActivityField
  fromValue String?
  toValue   String?

  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actorId   String?
  actor     User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
}

enum ActivityField {
  CREATED
  STATUS
  ASSIGNEE
  PRIORITY
  START_DATE
  DUE_DATE
}

/// 任務內的輕量工作清單項（純文字 + 勾選），position 用 float 便於拖排插入不重排
model ChecklistItem {
  id        String   @id @default(cuid())
  content   String
  done      Boolean  @default(false)
  position  Float    @default(0)

  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, position])
}

// ==================== Documents ====================

model Document {
  id          String            @id @default(cuid())
  name        String
  docType     DocType
  date        DateTime?
  contentUrl  String?
  /// rich text body（之後可改 jsonb 接 Tiptap / Lexical）
  body        String?

  authorId    String?
  author      User?             @relation("DocAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  tasks       TaskDocument[]
  projects    ProjectDocument[]

  archived    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([docType, date])
  @@index([authorId])
}

model TaskDocument {
  taskId     String
  documentId String

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([taskId, documentId])
  @@index([documentId])
}

model ProjectDocument {
  projectId  String
  documentId String

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([projectId, documentId])
  @@index([documentId])
}
